# Copy this file to .env and fill in local values. Never commit .env itself.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
# Use 5433 if a local PostgreSQL service already binds 5432
POSTGRES_PORT=5432
POSTGRES_DB=cyberforge

# Optional full connection string (overrides the individual POSTGRES_* values above)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyberforge

# Authentication, JWT & Cookie Hardening
# Generate a strong secret (>= 32 chars) e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-32-plus-character-random-secret-key
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
COOKIE_SECURE=false
DEBUG_OPENAPI=false
TRUST_PROXY_HEADERS=false

# Comma-separated allowed frontend origins for FastAPI CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional initial Admin & Moderator accounts seeded on FastAPI startup (leave blank to skip)
SEED_ADMIN_USERNAME=admin_root
SEED_ADMIN_EMAIL=admin@cyberforge.local
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_MOD_USERNAME=moderator_lead
SEED_MOD_EMAIL=moderator@cyberforge.local
SEED_MOD_PASSWORD=change-me-moderator-password

# Optional frontend API base URL (defaults to matching localhost / 127.0.0.1 :8000)
# VITE_API_URL=http://127.0.0.1:8000

# Live DVWA target integration (used by backend/dvwa.py)
DVWA_BASE_URL=http://127.0.0.1:8081
DVWA_USERNAME=admin
DVWA_PASSWORD=password
# DVWA_TIMEOUT=6.0
# DVWA_MAX_GLOBAL_CONCURRENCY=8
# DVWA_MAX_USER_CONCURRENCY=2
